{
  "name": "@local/shared-memory",
  "version": "1.0.0",
  "private": true,
  "description": "Shared memory for every DeepSeek Harness session and other AI apps: captured user messages, a live current-focus, and a local HTTP / MCP bridge.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    ".gitignore",
    "CHANGELOG.md",
    "LICENSE",
    "README.en.md",
    "README.md",
    "cordis.patch.yml",
    "docs/*.md",
    "docs/HOW-IT-WORKS.md",
    "docs/assets/*.svg",
    "icon.svg",
    "index.js",
    "locale/*.json",
    "mcp/server.mjs",
    "skills/*/SKILL.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shadyyoung/dsh-shared-memory.git"
  }
}
