{
  "name": "@local/shared-memory",
  "version": "1.6.1",
  "private": true,
  "description": "Shared Memory (AI 跨平台记忆增强) — cross-session, cross-app, cross-platform memory layer for DeepSeek Harness and other AI apps (Claude / Cursor / Codex / WorkBuddy) via local HTTP + MCP.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    ".github/workflows/*.yml",
    ".gitignore",
    "CHANGELOG.md",
    "LICENSE",
    "README.en.md",
    "README.md",
    "cordis.patch.yml",
    "docs/*.md",
    "docs/HOW-IT-WORKS.md",
    "docs/assets/*.svg",
    "icon.svg",
    "index.js",
    "locale/*.json",
    "mcp/server.mjs",
    "skills/*/SKILL.md",
    "standalone/*.mjs",
    "test/*.mjs",
    "ui/*.html"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shadyyoung/dsh-shared-memory.git"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "bench": "node test/search-bench.mjs",
    "install-apps": "node scripts/install-apps.mjs",
    "autostart": "node scripts/autostart.mjs install",
    "autostart:status": "node scripts/autostart.mjs status",
    "autostart:uninstall": "node scripts/autostart.mjs uninstall"
  }
}
